{
  "name": "sdrp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Disaster Response Platform — Express API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:embedded": "cross-env USE_EMBEDDED_MONGO=true nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:embedded": "cross-env USE_EMBEDDED_MONGO=true node src/seed/seed.js",
    "test:mongo": "node scripts/test-mongo.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "1.4.5-lts.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
